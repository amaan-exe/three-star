# ==============================================================================
# Residence Inn — Environment Configuration
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_ID>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Configuration
APP_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session Cookie (Minimum 32 random characters)
SESSION_COOKIE_SECRET=generate-a-random-32-char-string-here-32chars

# Security (Minimum 32 random characters)
HASH_SALT=generate-another-random-32-char-string-32ch

# Optional: Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional: LLM Review Drafting (Groq, Anthropic, or OpenAI API Key)
GROQ_API_KEY=your-groq-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# Firebase Service Account
FIREBASE_PROJECT_ID=star-e7eb0
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@star-e7eb0.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"star-e7eb0",...}'

